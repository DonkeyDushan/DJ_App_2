{
  "appId": "com.natsedlakova.djapp2",
  "productName": "DJ APP TURBO 2000",
  "directories": {
    "output": "C:/builds/dj-app-2"
  },
  "files": ["dist/**", "dist-electron/**"],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DJ App 2"
  }
}
