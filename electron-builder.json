{
  "appId": "com.natsedlakova.djapp2",
  "productName": "DJ APP TURBO 2000",
  "directories": {
    "output": "C:/builds/dj-app-2"
  },
  "files": ["dist/**", "dist-electron/**"],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DJ APP TURBO 2000"
  },
  "mac": {
    "category": "public.app-category.music",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ]
  },
  "dmg": {
    "title": "DJ APP TURBO 2000"
  }
}
